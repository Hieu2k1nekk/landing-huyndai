# Domain chính thức (canonical, sitemap, Open Graph). Bắt buộc khi deploy.
VITE_SITE_URL=https://www.ten-mien-cua-ban.vn
VITE_SITE_NAME=Hyundai Showroom

# Endpoint nhận form báo giá (POST JSON). Để trống => form báo lỗi "chưa cấu hình",
# KHÔNG giả lập gửi thành công.
VITE_LEAD_API_URL=

# Chỉ dùng khi phát triển (npm run dev): giả lập API để kiểm tra UI success state.
# Không có tác dụng ở bản build production.
VITE_LEAD_MOCK=false

# Liên hệ nhanh (có thể khai báo trực tiếp trong src/config/site.ts)
VITE_DEALER_HOTLINE=
VITE_DEALER_ZALO=
VITE_DEALER_MESSENGER=
